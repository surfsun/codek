{
  "name": "codek",
  "version": "1.0.0",
  "description": "A command-line coding agent inspired by Codex and Claude Code.",
  "bin": {
    "codek": "dist/cli.js"
  },
  "type": "module",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",

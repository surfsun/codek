    "dev": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "openai"
  ],
  "license": "MIT",
  "dependencies": {
    "openai": "^6.35.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  }
}
